{
    "framework": "nextjs",
    "redirects": [
        {
            "source": "/:path*",
            "has": [
                {
                    "type": "host",
                    "value": "www.opensadhaka.com"
                }
            ],
            "destination": "https://opensadhaka.com/:path*",
            "permanent": true
        }
    ]
}