{
    "framework": "nextjs",
    "redirects": [
        {
            "source": "/:path(.*)",
            "has": [
                {
                    "type": "host",
                    "value": "opensadhaka.com"
                }
            ],
            "destination": "https://www.opensadhaka.com/:path",
            "statusCode": 301
        }
    ]
}