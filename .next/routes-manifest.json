{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/compare/[slug]",
      "regex": "^/compare/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/compare/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/greats/[slug]",
      "regex": "^/greats/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/greats/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/learn/sanskrit/[word]",
      "regex": "^/learn/sanskrit/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPword": "nxtPword"
      },
      "namedRegex": "^/learn/sanskrit/(?<nxtPword>[^/]+?)(?:/)?$"
    },
    {
      "page": "/philosophies/[slug]",
      "regex": "^/philosophies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/philosophies/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/practices/[practice]/for/[goal]",
      "regex": "^/practices/([^/]+?)/for/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPpractice": "nxtPpractice",
        "nxtPgoal": "nxtPgoal"
      },
      "namedRegex": "^/practices/(?<nxtPpractice>[^/]+?)/for/(?<nxtPgoal>[^/]+?)(?:/)?$"
    },
    {
      "page": "/sitemap/[__metadata_id__]",
      "regex": "^/sitemap/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtP__metadata_id__": "nxtP__metadata_id__"
      },
      "namedRegex": "^/sitemap/(?<nxtP__metadata_id__>[^/]+?)(?:/)?$"
    },
    {
      "page": "/texts/[slug]",
      "regex": "^/texts/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/texts/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/topics/[topic]",
      "regex": "^/topics/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtopic": "nxtPtopic"
      },
      "namedRegex": "^/topics/(?<nxtPtopic>[^/]+?)(?:/)?$"
    },
    {
      "page": "/traditions/[slug]",
      "regex": "^/traditions/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/traditions/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/[slug]",
      "regex": "^/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_global-error",
      "regex": "^/_global\\-error(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_global\\-error(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/ancient-wisdom-philosophies",
      "regex": "^/ancient\\-wisdom\\-philosophies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/ancient\\-wisdom\\-philosophies(?:/)?$"
    },
    {
      "page": "/bhagavad-gita-complete-guide",
      "regex": "^/bhagavad\\-gita\\-complete\\-guide(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/bhagavad\\-gita\\-complete\\-guide(?:/)?$"
    },
    {
      "page": "/faith-finder",
      "regex": "^/faith\\-finder(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/faith\\-finder(?:/)?$"
    },
    {
      "page": "/greats",
      "regex": "^/greats(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/greats(?:/)?$"
    },
    {
      "page": "/philosophies",
      "regex": "^/philosophies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/philosophies(?:/)?$"
    },
    {
      "page": "/practical-spiritual-practices",
      "regex": "^/practical\\-spiritual\\-practices(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/practical\\-spiritual\\-practices(?:/)?$"
    },
    {
      "page": "/robots.txt",
      "regex": "^/robots\\.txt(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/robots\\.txt(?:/)?$"
    },
    {
      "page": "/sacred-texts-teachings",
      "regex": "^/sacred\\-texts\\-teachings(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sacred\\-texts\\-teachings(?:/)?$"
    },
    {
      "page": "/spiritual-traditions-paths",
      "regex": "^/spiritual\\-traditions\\-paths(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/spiritual\\-traditions\\-paths(?:/)?$"
    },
    {
      "page": "/texts",
      "regex": "^/texts(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/texts(?:/)?$"
    },
    {
      "page": "/texts/bhagavad-gita/chapter-[chapter]",
      "regex": "^/texts/bhagavad\\-gita/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPchapter": "nxtPchapter"
      },
      "namedRegex": "^/texts/bhagavad\\-gita/(?<nxtPchapter>[^/]+?)(?:/)?$"
    },
    {
      "page": "/texts/bhagavad-gita/chapter-[chapter]/shloka-[shloka]",
      "regex": "^/texts/bhagavad\\-gita/([^/]+?)/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPchapter": "nxtPchapter",
        "nxtPshloka": "nxtPshloka"
      },
      "namedRegex": "^/texts/bhagavad\\-gita/(?<nxtPchapter>[^/]+?)/(?<nxtPshloka>[^/]+?)(?:/)?$"
    },
    {
      "page": "/traditions",
      "regex": "^/traditions(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/traditions(?:/)?$"
    },
    {
      "page": "/yoga-sutras-complete-guide",
      "regex": "^/yoga\\-sutras\\-complete\\-guide(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/yoga\\-sutras\\-complete\\-guide(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments",
    "clientParamParsing": false,
    "dynamicRSCPrerender": false
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}