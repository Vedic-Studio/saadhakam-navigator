e:["$","div",null,{"className":"min-h-screen bg-background text-foreground flex flex-col","children":[["$","$L15",null,{"slug":"manas","pillar":"concepts"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What is the spiritual definition of Manas?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The lower, processing layer of the mind that continuously receives sensory data, remembers the past, worries about the future, and oscillates in doubt.\"}},{\"@type\":\"Question\",\"name\":\"How is Manas applied in spiritual practice?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Recognize that 'you' are not the noisy chatter in your skull. When Manas screams that you are a failure or that disaster is imminent, treat it like a panicked intern dropping papers on your desk. Acknowledge it, thank it for the warning, and let the executive Buddhi dismiss it as useless noise.\"}}]}"}}],["$","$L16",null,{}],["$","main",null,{"className":"flex-grow pt-24 pb-16","children":["$","div",null,{"className":"container-padding max-w-5xl mx-auto","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://opensadhaka.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Concepts\",\"item\":\"https://opensadhaka.com/learn\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Manas\",\"item\":\"https://opensadhaka.com/what-is-manas\"}]}"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-8","children":["$","ol",null,{"className":"flex items-center space-x-2 text-sm text-muted-foreground flex-wrap","children":[["$","li","/",{"className":"flex items-center","children":[["$","$L17",null,{"href":"/","className":"hover:text-fore