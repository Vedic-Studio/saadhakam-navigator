29:["$","section",null,{"className":"mb-16","children":[["$","h2",null,{"className":"font-display text-3xl font-bold mb-8","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What does 'Vedanta' literally mean?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Vedanta means 'the end of the Vedas' (Veda + anta). It refers to the Upanishads, which form the final and philosophical portion of the Vedic canon, and the school of thought derived from them."}]]}],["$","div","1",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What are the three schools of Vedanta?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"The three main schools are: Advaita Vedanta (non-dualism, taught by Adi Shankaracharya), Dvaita Vedanta (dualism, taught by Madhvacharya), and Vishishtadvaita (qualified non-dualism, taught by Ramanujacharya)."}]]}],["$","div","2",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Is Vedanta a religion?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Vedanta is a philosophy, not a religion. It provides the metaphysical framework underlying much of Hindu thought, but it can be studied and practiced independently of religious ritual."}]]}],["$","div","3",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What is the central teaching of Advaita Vedanta?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"The central teaching is 'Tat Tvam Asi' — That Thou Art. The individual soul (Atman) is not separate from the ultimate reality (Brahman). Liberation is the recognition of this identity."}]]}],["$","div","4",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"How is Vedanta different from yoga?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Vedanta is primarily a philosophical system that answers 'what is real?' and 'who am I?' Yoga is a practical system of disciplines. Jnana Yoga, one of the four yoga paths, is most closely aligned with Vedanta."}]]}],["$","div","5",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Can a Westerner practice Vedanta?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Yes. Vedanta is a system of self-inquiry and philosophical investigation. Swami Vivekananda's historic lectures in the West in 1893 demonstrated its universal relevance. It requires no conversion."}]]}],["$","div","6",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What texts are central to Vedanta?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"The Prasthanatrayi — three canonical texts: the Upanishads (primary scripture), the Bhagavad Gita (scripture in dialogue form), and the Brahma Sutras (systematic treatise). All three schools of Vedanta have written commentaries on these."}]]}],["$","div","7",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What is the practical benefit of studying Vedanta?"}],"$L2f"]}]]}]]}]
2a:["$","div",null,{"className":"bg-gradient-to-br from-orange-950/30 to-background rounded-3xl border border-orange-900/30 p-10 text-center","children":[["$","h2",null,{"className":"text-3xl font-display font-bold mb-4","children":"Ready to find your path?"}],["$","p",null,{"className":"text-lg text-muted-foreground mb-8 max-w-xl mx-auto","children":"Take the Faith Finder — a 5-minute quiz that maps your temperament to the specific tradition, practice, and philosophy within Sanatan Dharma that fits you."}],["$","$La",null,{"href":"/faith-finder","children":["$","button",null,{"className":"inline-flex items-center justify-center gap-2 whitespace-nowrap font-medium ring-offset-background focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 [&_svg]:pointer-events-none [&_svg]:size-4 [&_svg]:shrink-0 bg-orange-500 text-white hover:bg-orange-600 h-14 px-8 rounded-full text-lg shadow-lg shadow-orange-900/20 transition-transform hover:scale-105","children":["Start the Faith Finder",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right ml-2 w-5 h-5","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]}]]}]
