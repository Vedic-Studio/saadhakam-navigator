4:["$","main",null,{"className":"flex-grow pt-24 pb-16","children":["$","article",null,{"className":"container-padding max-w-3xl mx-auto","children":[[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://opensadhaka.com/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Ancient Wisdom\",\"item\":\"https://opensadhaka.com/ancient-wisdom-philosophies\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"What is Vedanta? A Complete Beginner's Guide\",\"item\":\"https://opensadhaka.com/what-is-vedanta\"}]}"}}],["$","nav",null,{"aria-label":"Breadcrumb","className":"mb-8","children":["$","ol",null,{"className":"flex items-center space-x-2 text-sm text-muted-foreground flex-wrap","children":[["$","li","/",{"className":"flex items-center","children":[["$","$La",null,{"href":"/","className":"hover:text-foreground transition-colors","children":"Home"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-4 h-4 mx-2 opacity-50 flex-shrink-0","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}]]}],["$","li","/ancient-wisdom-philosophies",{"className":"flex items-center","children":[["$","$La",null,{"href":"/ancient-wisdom-philosophies","className":"hover:text-foreground transition-colors","children":"Ancient Wisdom"}],["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-chevron-right w-4 h-4 mx-2 opacity-50 flex-shrink-0","children":[["$","path","mthhwq",{"d":"m9 18 6-6-6-6"}],"$undefined"]}]]}],["$","li","/what-is-vedanta",{"className":"flex items-center","children":["$","span",null,{"className":"text-foreground font-semibold","aria-current":"page","children":"What is Vedanta? A Complete Beginner's Guide"}]}]]}]}]],["$","header",null,{"className":"mb-12 mt-6","children":[["$","div",null,{"className":"flex items-center gap-3 mb-6","children":[["$","span",null,{"className":"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/10 text-orange-400 text-xs font-semibold uppercase tracking-wider","children":"Ancient Wisdom"}],["$","span",null,{"className":"flex items-center gap-1 text-muted-foreground text-sm","children":[["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-clock w-3.5 h-3.5","children":[["$","circle","1mglay",{"cx":"12","cy":"12","r":"10"}],["$","polyline","68esgv",{"points":"12 6 12 12 16 14"}],"$undefined"]}],10," min read"]}]]}],["$","h1",null,{"className":"font-display text-4xl md:text-5xl font-bold leading-tight mb-6","children":"What is Vedanta? A Complete Beginner's Guide"}],["$","p",null,{"className":"text-xl text-muted-foreground leading-relaxed","children":"Vedanta is the philosophical crown of the Vedas, exploring the nature of ultimate reality (Brahman) and the self (Atman). A complete beginner's guide to Advaita, Dvaita, and Vishishtadvaita."}]]}],["$","div",null,{"className":"prose prose-invert prose-orange max-w-none prose-headings:font-display prose-headings:font-bold prose-h2:text-3xl prose-h2:mt-14 prose-h2:mb-5 prose-h3:text-2xl prose-p:text-lg prose-p:leading-relaxed prose-p:text-muted-foreground prose-li:text-muted-foreground prose-li:text-lg prose-strong:text-foreground prose-a:text-orange-400 prose-a:no-underline hover:prose-a:text-orange-300 mb-16","children":[["$","p",null,{"children":["There is a question that surfaces in every spiritually curious person at some point: ","$Lb"," Vedanta is the tradition that takes this question with absolute seriousness."]}],"$Lc","$Ld","$Le","$Lf","$L10","$L11","$L12","$L13","$L14","$L15","$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27"]}],"$L28","$L29","$L2a"]}]}]
