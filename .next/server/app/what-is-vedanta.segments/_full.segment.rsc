19:["$","section",null,{"className":"mb-20","children":[["$","h2",null,{"className":"text-4xl font-display font-bold mb-12 text-center tracking-tight uppercase","children":"Common Questions"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-6","children":[["$","div","Is Vedanta a religion or a philosophy?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm transition-transform hover:-translate-y-1","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Is Vedanta a religion or a philosophy?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed pl-4 border-l-2 border-orange-500/20","children":"Vedanta is a philosophical system (*Darshana*) that arises from the Vedic tradition. While it forms the intellectual core of what is now called Hinduism, its principles—concerning consciousness, identity, and the nature of reality—are often approached as a universal science of the self."}]]}],["$","div","What does the word 'Vedanta' actually mean?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm transition-transform hover:-translate-y-1","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"What does the word 'Vedanta' actually mean?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed pl-4 border-l-2 border-orange-500/20","children":"The word is a compound of 'Veda' (knowledge) and 'Anta' (end or conclusion). It refers both to the chronological end of the Vedas (the Upanishads) and the logical culmination of all spiritual inquiry."}]]}],["$","div","Can anyone study Vedanta?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm transition-transform hover:-translate-y-1","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Can anyone study Vedanta?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed pl-4 border-l-2 border-orange-500/20","children":"Traditionally, Vedanta requires certain mental qualifications—clarity of intellect, emotional stability, and a genuine desire for truth. However, its primary texts, like the Bhagavad Gita, are designed to be accessible to everyone living in the world."}]]}]]}]]}]
1a:["$","section",null,{"className":"mb-20 rounded-3xl border border-border/60 bg-muted/5 p-10","children":[["$","div",null,{"className":"max-w-3xl mx-auto text-center","children":[["$","h2",null,{"className":"text-3xl font-display font-bold mb-6","children":"The Mahavakyas"}],["$","p",null,{"className":"text-lg text-muted-foreground leading-relaxed mb-10","children":"The entire Vedantic corpus is often distilled into four \"Great Sayings\" (*Mahavakyas*), one from each of the four Vedas. These are not merely philosophical statements, but meditative seeds meant to be contemplated until they become direct experiences of reality:"}]]}],["$","div",null,{"className":"grid sm:grid-cols-2 gap-6 max-w-4xl mx-auto","children":[["$","div",null,{"className":"p-6 rounded-2xl bg-background border border-border/40 text-center","children":[["$","h4",null,{"className":"font-bold text-orange-500 mb-1 italic","children":"Prajnanam Brahma"}],["$","p",null,{"className":"text-sm text-muted-foreground italic","children":"\"Consciousness is Brahman.\""}]]}],["$","div",null,{"className":"p-6 rounded-2xl bg-background border border-border/40 text-center","children":[["$","h4",null,{"className":"font-bold text-orange-500 mb-1 italic","children":"Aham Brahmasmi"}],["$","p",null,{"className":"text-sm text-muted-foreground italic","children":"\"I am Brahman.\""}]]}],["$","div",null,{"className":"p-6 rounded-2xl bg-background border border-border/40 text-center","children":[["$","h4",null,{"className":"font-bold text-orange-500 mb-1 italic","children":"Tat Tvam Asi"}],["$","p",null,{"className":"text-sm text-muted-foreground italic","children":"\"That Thou Art.\""}]]}],["$","div",null,{"className":"p-6 rounded-2xl bg-background border border-border/40 text-center","children":[["$","h4",null,{"className":"font-bold text-orange-500 mb-1 italic","children":"Ayam Atma Brahma"}],["$","p",null,{"className":"text-sm text-muted-foreground italic","children":"\"This Self is Brahman.\""}]]}]]}]]}]
