assName":"flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group","children":[["$","span",null,{"className":"text-sm font-medium group-hover:text-orange-400 transition-colors","children":"Advaita vs Vishishtadvaita"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4 text-muted-foreground group-hover:text-orange-400 group-hover:translate-x-1 transition-all","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]}],["$","li","/compare/stoicism-vs-vedanta",{"children":["$","$L38",null,{"href":"/compare/stoicism-vs-vedanta","eventLabel":"article_related_link:non-duality-vs-dualism:/compare/stoicism-vs-vedanta","trackPathName":"ancient-wisdom","className":"flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group","children":[["$","span",null,{"className":"text-sm font-medium group-hover:text-orange-400 transition-colors","children":"Stoicism vs Vedanta"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4 text-muted-foreground group-hover:text-orange-400 group-hover:translate-x-1 transition-all","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]}],["$","li","/what-is-brahman",{"children":["$","$L38",null,{"href":"/what-is-brahman","eventLabel":"article_related_link:non-duality-vs-dualism:/what-is-brahman","trackPathName":"ancient-wisdom","className":"flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group","children":[["$","