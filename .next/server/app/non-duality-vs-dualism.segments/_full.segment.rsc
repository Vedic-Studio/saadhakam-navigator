ne hover:prose-a:text-orange-300 mb-16","children":[["$","p",null,{"className":"lead text-xl font-medium mb-8","children":["The most important question you will ever ask is hidden inside your spiritual practice: ","$L1c"]}],"$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31"]}],"$L32","$L33","$L34"]}]}]
