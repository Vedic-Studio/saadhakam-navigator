36:["$","section",null,{"className":"mb-16","children":[["$","h2",null,{"className":"font-display text-3xl font-bold mb-8","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"When did Adi Shankaracharya live?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Traditional dates place Shankaracharya between 788–820 CE, though some scholars argue for earlier dates. He lived only 32 years — an astonishing brevity given his philosophical output."}]]}],["$","div","1",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What did Shankaracharya teach?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Shankaracharya systematized Advaita Vedanta — the philosophy of non-dualism. His central teaching: Brahman alone is real; the individual soul (Atman) and the universe are not separate from Brahman. Apparent multiplicity is Maya."}]]}],["$","div","2",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What are the four Mathas established by Shankaracharya?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"The four cardinal monasteries: Sringeri (South), Puri (East), Dwaraka (West), and Jyotirmath (North). Each oversees one of the four Vedas and is headed by a Shankaracharya in the lineage — a tradition unbroken for 1,200 years."}]]}],["$","div","3",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What major texts did Shankaracharya write?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"His commentaries on the Upanishads, Bhagavad Gita, and Brahma Sutras are definitive. His independent works include Vivekachudamani (The Crest Jewel of Discrimination), Atma Bodha, and devotional hymns like Bhaja Govindam."}]]}],["$","div","4",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Why is Shankaracharya called 'Adi'?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"'Adi' means 'first' or 'original.' He is Adi Shankaracharya to distinguish him from later teachers in his lineage who took the title Shankaracharya. He is the originator."}]]}],["$","div","5",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What is the Digvijaya — Shankaracharya's journey?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"The Digvijaya (conquest of directions) was Shankaracharya's journey across India on foot, debating scholars of every school — Mimamsakas, Buddhists, Jains, Shaivas — and establishing Advaita as the preeminent philosophical system."}]]}],["$","div","6",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"How did Shankaracharya unify Hinduism?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"He established the Shanmata system — the worship of six deities (Shiva, Vishnu, Devi, Ganesha, Surya, Skanda) as different manifestations of the one Brahman. This gave seekers of different temperaments a unified framework."}]]}],["$","div","7",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":["$L3e","$L3f"]}]]}]]}]
37:["$","div",null,{"className":"bg-gradient-to-br from-orange-950/30 to-background rounded-3xl border border-orange-900/30 p-10 text-center","children":[["$","h2",null,{"className":"text-3xl font-display font-bold mb-4","children":"Ready to find your path?"}],["$","p",null,{"className":"text-lg text-muted-foreground mb-8 max-w-xl mx-auto","children":"Take the Faith Finder — a 5-minute quiz that maps your temperament to the specific tradition, practice, and philosophy within Sanatan Dharma that fits you."}],["$","$L3b",null,{"href":"/faith-finder","eventLabel":"article_cta:adi-shankaracharya-life-teachings:faith-finder","trackPathName":"ancient-wisdom","className":"inline-flex items-center justify-center bg-orange-500 text-white hover:bg-orange-600 h-14 px-8 rounded-full text-lg shadow-lg shadow-orange-900/20 transition-transform hover:scale-105","children":["Start the Faith Finder",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right ml-2 w-5 h-5","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]
