ons","className":"flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group","children":[["$","span",null,{"className":"text-sm font-medium group-hover:text-orange-400 transition-colors","children":"Bhakti vs Jnana Yoga"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4 text-muted-foreground group-hover:text-orange-400 group-hover:translate-x-1 transition-all","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]}],["$","li","/traditions",{"children":["$","$L40",null,{"href":"/traditions","eventLabel":"article_related_link:shaivism-vs-vaishnavism:/traditions","trackPathName":"spiritual-traditions","className":"flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group","children":[["$","span",null,{"className":"text-sm font-medium group-hover:text-orange-400 transition-colors","children":"Explore Traditions"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4 text-muted-foreground group-hover:text-orange-400 group-hover:translate-x-1 transition-all","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]}],["$","li","/faith-finder",{"children":["$","$L40",null,{"href":"/faith-finder","eventLabel":"article_related_link:shaivism-vs-vaishnavism:/faith-finder","trackPathName":"spiritual-traditions","className":"flex items-center justify-between p-3 rounded-xl hover:bg-white/5 transition-colors group","children":[["$","span",null,{"className":"text-sm font-medium group-hover:text-orange-400 transition-colors","children":"Find Your Path"}],["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right w-4 h-4 text-muted-foreground group-hover:text-orange-400 group-hover:translate-x-1 transition-all","children":["$L41","$L42","$undefined"]}]]}]}]]}]]}]
3b:["$","section",null,{"className":"mb-16","children":[["$","h2",null,{"className":"font-display text-3xl font-bold mb-8","children":"Frequently Asked Questions"}],["$","div",null,{"className":"space-y-6","children":[["$","div","0",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What is Shaivism?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Shaivism is the tradition centered on Shiva as the Supreme Being — the cosmic yogi, destroyer, regenerator, and lord of consciousness. It is one of the four major denominations of Hinduism and spans multiple philosophical schools including Kashmir Shaivism and Shaiva Siddhanta."}]]}],["$","div","1",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What is Vaishnavism?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Vaishnavism centers on Vishnu and his avatars (especially Krishna and Rama) as the Supreme. It is the largest Hindu denomination by global following and encompasses traditions from Sri Vaishnavism (South India) to the Gaudiya Vaishnavism of ISKCON."}]]}],["$","div","2",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Are Shaivites and Vaishnavas in conflict?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Historically, there were theological debates and occasionally communal tensions. Today, the two traditions coexist respectfully. Adi Shankaracharya's Shanmata system explicitly treats Shiva and Vishnu as equal manifestations of one Brahman."}]]}],["$","div","3",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Which path is more philosophical?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Both have rigorous philosophical traditions. Kashmir Shaivism is among the most sophisticated philosophical systems ever developed. Vishishtadvaita and Dvaita — the philosophical backbones of Vaishnavism — are equally systematic."}]]}],["$","div","4",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"What is the difference in their view of liberation?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"In Shaivism: liberation is the recognition of one's own nature as Shiva-consciousness. In Vaishnavism: liberation (Mukti) is typically understood as eternal devotional relationship with Vishnu, with the soul retaining its identity."}]]}],["$","div","5",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Can someone worship both Shiva and Vishnu?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Absolutely. The Harihara form — half Shiva, half Vishnu — is worshipped in temples across India. The Smarta tradition (following Adi Shankaracharya) treats all deities as manifestations of one Brahman and actively worships both."}]]}],["$","div","6",{"className":"p-6 rounded-2xl border border-border/50 bg-card","children":[["$","h3",null,{"className":"font-semibold text-lg mb-3","children":"Which tradition is the Bhagavad Gita associated with?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"The Gita features Krishna (a Vaishnava avatar) as the teacher. It is most central to Vaishnavism and is the key scripture for Gaudiya Vaishnavas, ISKCON, and Sri Vaishnavas. However, Adi Shankaracharya (Shaiva) also wrote the most acclaimed Advaitic commentary on it."}]]}],"$L43"]}]]}]
3c:["$","div",null,{"className":"bg-gradient-to-br from-orange-950/30 to-background rounded-3xl border border-orange-900/30 p-10 text-center","children":[["$","h2",null,{"className":"text-3xl font-display font-bold mb-4","children":"Ready to find your path?"}],["$","p",null,{"className":"text-lg text-muted-foreground mb-8 max-w-xl mx-auto","children":"Take the Faith Finder — a 5-minute quiz that maps your temperament to the specific tradition, practice, and philosophy within Sanatan Dharma that fits you."}],["$","$L40",null,{"href":"/faith-finder","eventLabel":"article_cta:shaivism-vs-vaishnavism:faith-finder","trackPathName":"spiritual-traditions","className":"inline-flex items-center justify-center bg-orange-500 text-white hover:bg-orange-600 h-14 px-8 rounded-full text-lg shadow-lg shadow-orange-900/20 transition-transform hover:scale-105","children":["Start the Faith Finder",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right ml-2 w-5 h-5","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]
