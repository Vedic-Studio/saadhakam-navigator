16:["$","section",null,{"className":"pt-16 border-t border-border","children":[["$","div",null,{"className":"text-center mb-12","children":[["$","h2",null,{"className":"font-display text-3xl font-bold mb-4","children":"Frequently Asked Questions"}],["$","p",null,{"className":"text-muted-foreground max-w-2xl mx-auto","children":"Common beginner questions about studying Vedanta, Darshanas, and the philosophical side of Sanatan Dharma."}]]}],["$","div",null,{"className":"grid md:grid-cols-2 gap-6","children":[["$","div","What should a beginner read first in Indian philosophy?",{"className":"rounded-2xl border border-border/60 bg-card p-6","children":[["$","h3",null,{"className":"text-lg font-semibold mb-3","children":"What should a beginner read first in Indian philosophy?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Most seekers should begin with Vedanta because it introduces the big questions clearly: What is the self? What is reality? What causes suffering? From there, comparisons with Samkhya, Yoga, and Bhakti traditions become much easier to understand."}]]}],["$","div","Is ancient Indian philosophy purely intellectual?",{"className":"rounded-2xl border border-border/60 bg-card p-6","children":[["$","h3",null,{"className":"text-lg font-semibold mb-3","children":"Is ancient Indian philosophy purely intellectual?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"No. In Sanatan Dharma, philosophy is inseparable from liberation. The purpose of debate is not winning arguments; it is removing confusion so practice becomes precise and realization becomes possible."}]]}],["$","div","What is the difference between philosophy and tradition in Hinduism?",{"className":"rounded-2xl border border-border/60 bg-card p-6","children":[["$","h3",null,{"className":"text-lg font-semibold mb-3","children":"What is the difference between philosophy and tradition in Hinduism?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"A philosophy explains reality at the level of concepts and metaphysics. A tradition translates those insights into worship, meditation, ethics, teacher lineages, and lived culture. The two are deeply connected but not identical."}]]}],["$","div","Why do Advaita and Dvaita both exist if they read the same scriptures?",{"className":"rounded-2xl border border-border/60 bg-card p-6","children":[["$","h3",null,{"className":"text-lg font-semibold mb-3","children":"Why do Advaita and Dvaita both exist if they read the same scriptures?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed","children":"Because the shared source texts — especially the Upanishads, Bhagavad Gita, and Brahma Sutras — are rich enough to support different interpretive emphases. Different acharyas draw out different relationships between God, soul, and world."}]]}]]}]]}]
