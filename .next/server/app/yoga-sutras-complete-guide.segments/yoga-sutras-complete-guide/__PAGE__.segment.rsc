2:T46d,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"What are the Yoga Sutras of Patanjali?","acceptedAnswer":{"@type":"Answer","text":"The Yoga Sutras is a foundational text of yoga philosophy compiled by Sage Patanjali around 400 CE. It consists of 196 terse aphorisms (sutras) describing the systematic process to control the mind and attain liberation."}},{"@type":"Question","name":"What is Ashtanga Yoga?","acceptedAnswer":{"@type":"Answer","text":"Ashtanga Yoga means 'The Eight-Limbed Path'. It outlines a comprehensive journey: ethical restraints (Yamas), observances (Niyamas), physical postures (Asana), breath control (Pranayama), sensory withdrawal (Pratyahara), concentration (Dharana), meditation (Dhyana), and absorption (Samadhi)."}},{"@type":"Question","name":"What is the ultimate goal of Yoga according to Patanjali?","acceptedAnswer":{"@type":"Answer","text":"Patanjali defines yoga as 'Chitta Vritti Nirodha' or the cessation of the modifications (fluctuations) of the mind. The ultimate goal is Kaivalya, absolute freedom and realization of the true self (Purusha)."}}]}0:{"buildId":"ei-e6ON9UzJ8qvvBSPRZ3","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-background","children":[["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://opensadhaka.com\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Sacred Texts\",\"item\":\"https://opensadhaka.com/texts\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Yoga Sutras Complete Guide\",\"item\":\"https://opensadhaka.com/yoga-sutras-complete-guide\"}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"Yoga Sutras of Patanjali | Complete Guide to Ashtanga Yoga\",\"description\":\"Explore the Yoga Sutras of Patanjali. A complete guide to the 8 limbs of yoga (Ashtanga), Samadhi, and the practical path to mental discipline and liberation.\",\"author\":{\"@type\":\"Organization\",\"name\":\"Sadhaka\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"Sadhaka\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://opensadhaka.com/favicon.ico\"}}}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$2"}}],["$","$L3",null,{}],["$","main",null,{"className":"pt-20","children":[["$","section",null,{"className":"bg-primary/5 py-20 px-4 sm:px-6 lg:px-8 border-b border-border/40","children":["$","div",null,{"className":"max-w-4xl mx-auto text-center","children":[["$","div",null,{"className":"mb-4 text-sm text-primary font-bold uppercase tracking-widest","children":"Sacred Text Guide"}],["$","h1",null,{"className":"font-display text-4xl md:text-6xl font-extrabold text-foreground mb-6 leading-tight","children":["The Complete Guide to the ",["$","span",null,{"className":"text-secondary","children":"Yoga Sutras"}]]}],["$","p",null,{"className":"text-xl md:text-2xl text-muted-foreground font-medium max-w-2xl mx-auto leading-relaxed","children":"Discover the ancient manual for stilling the mind. Master the Eight Limbs of Yoga (Ashtanga) and achieve ultimate freedom."}]]}]}],["$","section",null,{"className":"py-16 px-4 sm:px-6 lg:px-8 pb-20","children":["$","div",null,{"className":"max-w-4xl mx-auto space-y-16","children":[["$","div",null,{"className":"prose prose-lg dark:prose-invert max-w-none text-muted-foreground leading-relaxed","children":["$L4","$L5"]}],"$L6","$L7","$L8","$L9","$La"]}]}]]}],"$Lb"]}],["$Lc","$Ld"],"$Le"]}],"loading":null,"isPartial":false}
4:["$","p",null,{"children":["Compiled around 400 CE by the sage Patanjali, the ",["$","strong",null,{"children":"Yoga Sutras"}]," consist of 196 short aphorisms (sutras) that synthesize older traditions of contemplative practice into a coherent, highly structured philosophical framework. Known as Raja Yoga, this text provides a practical, step-by-step roadmap to transcending mental suffering."]}]
5:["$","p",null,{"children":["Unlike modern perceptions of yoga that focus primarily on physical exercise, the Yoga Sutras emphasize mastering the mind. The very second sutra clearly defines its entire methodology: ",["$","em",null,{"children":"\"Yogas chitta vritti nirodha\""}]," — Yoga is the stilling of the changing states of the mind. Check out our ",["$","$Lf",null,{"href":"/what-is-yoga","className":"text-primary font-medium hover:underline","children":"guide on Yoga"}]," for foundational context."]}]
