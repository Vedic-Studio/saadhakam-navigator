["$","li",null,{"children":[["$","strong",null,{"children":"6. Dharana (Concentration):"}]," Focusing the mind on a single point or object."]}],["$","li",null,{"children":[["$","strong",null,{"children":"7. Dhyana (Meditation):"}]," An unbroken flow of concentrated awareness."]}],["$","li",null,{"children":[["$","strong",null,{"children":"8. Samadhi (Absorption):"}]," True union where the meditator, the object of meditation, and the act of meditating become one."]}]]}]]}]]}]
