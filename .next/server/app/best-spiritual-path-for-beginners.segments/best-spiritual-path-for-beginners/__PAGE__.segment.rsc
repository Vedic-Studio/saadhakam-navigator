11:["$","section",null,{"className":"mb-20 prose prose-invert max-w-none border-y border-border/40 py-20","children":["$","div",null,{"className":"max-w-3xl mx-auto","children":[["$","h2",null,{"className":"font-display text-4xl font-bold mb-10 text-center","children":"The Philosophy of Temperament"}],["$","p",null,{"className":"text-xl leading-relaxed mb-8","children":["In Sanatan Dharma, the concept of ",["$","strong",null,{"children":"Gunas"}]," (the three qualities of nature) explains why one path works for you while another fails. We are all composed of ",["$","em",null,{"children":"Sattva"}]," (clarity), ",["$","em",null,{"children":"Rajas"}]," (activity), and ",["$","em",null,{"children":"Tamas"}]," (inertia) in varying proportions."]}],["$","ul",null,{"className":"space-y-6 list-none p-0","children":[["$","li",null,{"className":"bg-muted/20 p-6 rounded-2xl border border-border/40","children":[["$","strong",null,{"className":"text-orange-400 block text-lg mb-2","children":"Rajasic Minds"}],["$","p",null,{"className":"text-muted-foreground","children":"Driven by ambition and energy. Karma Yoga provides the perfect outlet, using that energy for selfless service instead of personal gain."}]]}],["$","li",null,{"className":"bg-muted/20 p-6 rounded-2xl border border-border/40","children":[["$","strong",null,{"className":"text-orange-400 block text-lg mb-2","children":"Sattvic Minds"}],["$","p",null,{"className":"text-muted-foreground","children":"Naturally calm and reflective. These seekers thrive in Jnana Yoga, where they can use their existing clarity to pierce through illusion."}]]}]]}],["$","p",null,{"className":"text-lg text-muted-foreground leading-relaxed mt-10 italic text-center","children":"The path you choose is not a destination; it's the vehicle you use to move toward the same ultimate peak."}]]}]}]
