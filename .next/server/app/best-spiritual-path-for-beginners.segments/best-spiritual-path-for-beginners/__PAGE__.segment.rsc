13:["$","section",null,{"className":"mb-20 shadow-2xl overflow-hidden relative rounded-3xl border border-orange-900/40 bg-gradient-to-br from-orange-950/20 to-background p-12 text-center","children":["$","div",null,{"className":"relative z-10","children":[["$","h2",null,{"className":"text-4xl font-display font-bold mb-4","children":"Want a recommendation for your type?"}],["$","p",null,{"className":"text-xl text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed","children":["Don't guess with your spiritual life. Take the ",["$","strong",null,{"children":"Faith Finder"}]," and map your specific psychological architectural to the traditions engineered for your nature."]}],["$","$L1a",null,{"href":"/faith-finder","eventLabel":"chooser_cta:best-spiritual-path-for-beginners:faith-finder","trackPathName":"faith-finder","className":"inline-flex items-center rounded-full bg-orange-600 hover:bg-orange-700 px-10 py-5 text-white font-bold text-xl shadow-lg hover:shadow-orange-500/20 transition-all active:scale-95","children":["Discover My Path ",["$","svg",null,{"xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right ml-2 w-6 h-6","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]}]
14:["$","section",null,{"className":"mb-20","children":[["$","h2",null,{"className":"font-display text-4xl font-bold mb-10 text-center","children":"Frequently asked questions"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-6","children":[["$","div","How do I know which of the four paths is mine?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"How do I know which of the four paths is mine?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Look at your strongest natural tendency. If you are emotional, Bhakti is yours. If you are restless for action, Karma is yours. If you are routine-driven, Raja is yours. If you are analytical, Jnana is yours. Most people are a 'cocktail' of all four, with one dominant path."}]]}],["$","div","Is one path 'higher' or more advanced than others?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Is one path 'higher' or more advanced than others?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"No. The Bhagavad Gita teaches that all four paths lead to the same peak. The 'highest' path is simply the one you can practice most consistently without force or inner conflict."}]]}],["$","div","Can I combine these paths as a beginner?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Can I combine these paths as a beginner?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Yes. In fact, a synthesis is often recommended. A common 'beginner stack' is Karma Yoga during work hours, Bhakti Yoga for emotional stability, and Raja Yoga for 15 minutes of seated meditation daily."}]]}],["$","div","How long should I test a path before deciding if it works?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"How long should I test a path before deciding if it works?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"We recommend a 40-day 'Mandala.' It takes roughly 40 days for the nervous system and subconscious habits (Samskaras) to begin realigning with a new spiritual practice."}]]}]]}]]}]
