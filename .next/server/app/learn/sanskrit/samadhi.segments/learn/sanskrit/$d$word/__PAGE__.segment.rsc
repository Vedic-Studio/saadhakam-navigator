ect."]}]]}]]}],["$","div","1",{"className":"relative group","children":[["$","div",null,{"className":"absolute -left-4 top-0 bottom-0 w-1 bg-primary/20 group-hover:bg-primary transition-colors rounded-full"}],["$","div",null,{"className":"pl-8","children":[["$","div",null,{"className":"text-xs font-black uppercase tracking-widest text-muted-foreground mb-4","children":"Bhagavad Gita 2.53"}],["$","blockquote",null,{"className":"mb-6","children":[["$","p",null,{"className":"text-3xl md:text-4xl font-display font-bold tracking-tight mb-4 leading-tight italic","children":["\"","श्रुतिविप्रतिपन्ना ते यदा स्थास्यति निश्चला । समाधावचला बुद्धिस्तदा योगमवाप्स्यसि ॥","\""]}],["$","p",null,{"className":"text-xl text-muted-foreground font-medium italic","children":["— ","When your intellect, bewildered by the scriptures, remains steady and immovable in Samadhi, then you will attain Yoga."]}]]}],["$","div",null,{"className":"p-6 bg-muted/30 rounded-2xl border border-border/20 text-muted-foreground text-sm font-medium leading-relaxed","children":[["$","strong",null,{"children":"Significance:"}]," ","Krishna explains that true spiritual union (Yoga) only occurs when intellectual confusion ceases and the mind rests perfectly in Samadhi."]}]]}]]}]]}]]}]
