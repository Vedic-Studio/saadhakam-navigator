0:{"buildId":"TiFSmxZ12onlCPNY3MpXZ","rsc":["$","$1","c",{"children":[["$","div",null,{"className":"min-h-screen bg-background text-foreground flex flex-col","children":[["$","$L2",null,{"slug":"samadhi","pillar":"sanskrit-lexicon"}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is Samadhi the same as Moksha?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not exactly. Samadhi is a state of deep meditative absorption. Moksha is the permanent liberation from Samsara. Nirvikalpa Samadhi leads to Moksha, but lower states of Samadhi are temporary.\"}},{\"@type\":\"Question\",\"name\":\"Are you unconscious in Samadhi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No, it is the exact opposite. You are 'unconscious' of the physical world or the ego, but you are experiencing 'super-consciousness'—the purest form of awareness.\"}},{\"@type\":\"Question\",\"name\":\"Why do they call a saint's tomb a Samadhi?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Great yogis do not 'die'; they consciously exit their bodies in a final, irreversible state of absorption called Mahasamadhi. The place where their body is buried holds that spiritual resonance.\"}}]}"}}],["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"DefinedTerm\",\"name\":\"Samadhi\",\"description\":\"Samadhi is the pinnacle of the yogic path—a state of ecstatic, non-dual absorption where the illusion of the separate self dissolves into pure consciousness.\",\"url\":\"https://opensadhaka.com/learn/sanskrit/samadhi\",\"inDefinedTermSet\":\"https://opensadhaka.com/learn/sanskrit\"}"}}],["$","$L3",null,{}],["$","main",null,{"className":"flex-grow pt-24 pb-16","children":["$","div",null,{"className":"container-padding max-w-5xl mx-auto","children":[[["$","script",null,{"typ