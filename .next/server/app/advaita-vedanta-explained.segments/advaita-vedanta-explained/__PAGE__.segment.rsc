6:["$","p",null,{"className":"text-lg text-muted-foreground leading-relaxed mb-6","children":"Adi Shankara, the 8th-century master who systematized Advaita, used the analogy of a rope and a snake to explain our misperception of reality. If you see a coiled rope in dim light and mistake it for a snake, your fear is real. Your heart races, and you might run away. The snake, however, has no objective reality; it is a superimposition (Adhyasa) of your mind onto the rope."}]
7:["$","div",null,{"className":"grid md:grid-cols-2 gap-6 mt-8","children":[["$","div",null,{"className":"bg-background/50 p-6 rounded-2xl border border-border/20","children":[["$","h4",null,{"className":"font-bold mb-2 uppercase text-xs tracking-widest text-orange-400","children":"The Error"}],["$","p",null,{"className":"text-sm text-muted-foreground italic","children":"\"I am a small, vulnerable individual separate from the world.\""}]]}],["$","div",null,{"className":"bg-background/50 p-6 rounded-2xl border border-border/20","children":[["$","h4",null,{"className":"font-bold mb-2 uppercase text-xs tracking-widest text-green-400","children":"The Correction"}],["$","p",null,{"className":"text-sm text-muted-foreground italic","children":"\"I am the awareness in which the world and the individual appear.\""}]]}]]}]
8:["$","section",null,{"children":[["$","h2",null,{"className":"text-3xl font-display font-bold mb-6","children":"The Two Tiers of Reality"}],["$","p",null,{"className":"text-xl text-muted-foreground leading-relaxed mb-6","children":["Advaita acknowledges that we live in a world of multiplicity while insisting on underlying unity. To resolve this tension, it establishes two levels of perspective: ",["$","strong",null,{"className":"text-foreground","children":"Vyavaharika"}]," (Conventional Reality) and ",["$","strong",null,{"className":"text-foreground","children":"Paramarthika"}]," (Absolute Reality)."]}],["$","div",null,{"className":"space-y-4","children":[["$","div",null,{"className":"flex gap-4 items-start p-6 rounded-2xl border border-border/40 hover:bg-muted/20 transition-colors","children":[["$","div",null,{"className":"w-10 h-10 rounded-full bg-orange-500/20 flex items-center justify-center text-orange-500 font-bold shrink-0","children":"1"}],["$","div",null,{"children":[["$","h4",null,{"className":"font-bold text-lg mb-1","children":"Conventional (The Map)"}],["$","p",null,{"className":"text-muted-foreground","children":"The realm of time, space, cause, and effect. Here, moral duties, rituals, and personal relationships are real and necessary for spiritual growth."}]]}]]}],["$","div",null,{"className":"flex gap-4 items-start p-6 rounded-2xl border border-border/40 hover:bg-muted/20 transition-colors","children":[["$","div",null,{"className":"w-10 h-10 rounded-full bg-orange-500/20 flex items-center justify-center text-orange-500 font-bold shrink-0","children":"2"}],["$","div",null,{"children":[["$","h4",null,{"className":"font-bold text-lg mb-1","children":"Absolute (The Terrian)"}],["$","p",null,{"className":"text-muted-foreground","children":"The realization that only Brahman is ultimately real. From this height, all distinctions of 'me' and 'thee' dissolve into a singular field of being."}]]}]]}]]}]]}]
