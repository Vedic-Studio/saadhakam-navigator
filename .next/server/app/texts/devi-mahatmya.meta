{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/texts/layout,_N_T_/texts/[slug]/layout,_N_T_/texts/[slug]/page,_N_T_/texts/devi-mahatmya"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/texts/$d$slug/__PAGE__",
    "/texts/$d$slug",
    "/texts",
    "/_index",
    "/_head"
  ]
}