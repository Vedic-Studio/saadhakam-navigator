{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/traditions/layout,_N_T_/traditions/[slug]/layout,_N_T_/traditions/[slug]/page,_N_T_/traditions/kashmir-shaivism"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/traditions/$d$slug/__PAGE__",
    "/traditions/$d$slug",
    "/traditions",
    "/_index",
    "/_head"
  ]
}