:[["$","p","0",{"children":[["$","$1","0",{"children":"Imagine discovering that the boundary between yourself and everything else is not a wall — it is a thought. A deeply conditioned, thoroughly believed, entirely convincing thought. But a thought nonetheless. This is the central claim of Advaita Vedanta, and it changes everything."}]]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21","$L22","$L23","$L24","$L25","$L26","$L27","$L28","$L29","$L2a","$L2b","$L2c","$L2d","$L2e","$L2f","$L30","$L31","$L32","$L33","$L34","$L35","$L36","$L37","$L38","$L39","$L3a","$L3b","$L3c","$L3d"]}],"$L3e","$L3f","$L40"]}]}]
