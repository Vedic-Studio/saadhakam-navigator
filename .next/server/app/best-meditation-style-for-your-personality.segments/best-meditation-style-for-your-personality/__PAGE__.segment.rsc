17:["$","section",null,{"className":"mb-20","children":[["$","h2",null,{"className":"font-display text-4xl font-bold mb-10 text-center","children":"Frequently Asked Questions"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-6","children":[["$","div","What meditation style is best for beginners?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"What meditation style is best for beginners?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Most beginners fail because they start with silent meditation (Dhyana). For the modern, digital mind, Japa or Pranayama-led meditation is significantly more effective because both provide an immediate 'job' for the mind to do, reducing the frustration of initial failure."}]]}],["$","div","What meditation style is best for anxiety?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"What meditation style is best for anxiety?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Anxiety is a physiological event. Therefore, Pranayama-led meditation is the direct antidote. By slowing the breath, you signal safety to the nervous system, which naturally collapses the psychological feedback loop of anxious thinking."}]]}],["$","div","How long should I practice a style before switching?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"How long should I practice a style before switching?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Commitment is more important than the specific style. We recommend a 40-day 'Mandala'—practicing one method consistently for 40 days to actually observe the neurological shifts before deciding if it's the right fit for your temperament."}]]}],["$","div","Can I combine more than one meditation style?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Can I combine more than one meditation style?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Yes. A common and effective sequence is: 5 minutes of Pranayama (to ground), 10 minutes of Japa (to focus), and 5 minutes of silent Dhyana (to rest in that focus)."}]]}]]}]]}]
