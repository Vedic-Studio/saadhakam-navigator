ildren":[["$","p",null,{"className":"text-2xl text-foreground font-medium leading-tight","children":"Spiritual progress is not about finding the \"best\" system, but the system that best matches your current psychological momentum."}],["$","p",null,{"className":"text-lg text-muted-foreground leading-relaxed","children":"The four paths of Sanatan Dharma were not created by different religions; they were engineered by the same Vedic masters to accommodate the four primary human archetypes: the Lover (Bhakti), the Thinker (Jnana), the Doer (Karma), and the Disciplinarian (Raja)."}],["$","p",null,{"className":"text-lg text-muted-foreground leading-relaxed","children":"Below is a decision matrix designed to help you bypass the noise and identify the path that fits your innate structure (Svadharma)."}]]}],["$","div",null,{"className":"bg-orange-600/10 border border-orange-500/20 rounded-2xl p-6 hidden md:block","children":[["$","h3",null,{"className":"text-orange-400 font-bold mb-2 uppercase text-xs tracking-widest","children":"The \"Neti-Neti\" Test"}],["$","p",null,{"className":"text-sm text-muted-foreground leading-relaxed","children":["If you prefer logic over ritual, start with ",["$","strong",null,{"children":"Jnana"}],". If you value action over sitting, start with ",["$","strong",null,{"children":"Karma"}],"."]}]]}]]}]]}],["$","section",null,{"className":"mb-20 rounded-3xl border border-border/60 bg-muted/10 p-10 overflow-hidden relative","children":[["$","h2",null,{"className":"font-display text-4xl font-bold mb-10 text-center","children":"Master Decision Matrix"}],["$","div",null,{"className":"overflow-x-auto","children":["$","table",null,{"className":"w-full text-left min-w-[900px] relative z-10","children":[["$","thead",null,{"children":["$","tr",null,{"className":"border-b border-border","children":[["$","th",null,{"className":"py-4 pr-6 text-orange-400 font-bold uppercase tracking-widest text-xs","children":"Path"}],["$","th",null,{"className":"py-4 pr-6 tex