22:["$","section",null,{"className":"mb-20 prose prose-invert max-w-none border-y border-border/40 py-20","children":["$","div",null,{"className":"max-w-3xl mx-auto","children":[["$","h2",null,{"className":"font-display text-4xl font-bold mb-10 text-center","children":"The Power of Synthesis"}],["$","p",null,{"className":"text-xl leading-relaxed mb-8","children":["While one path usually dominates your temperament, the Vedic tradition recommends a ",["$","strong",null,{"children":"Synthesis of Yoga"}]," to ensure balanced growth. Pure Jnana (Head) without Bhakti (Heart) leads to dry intellectualism. Pure Bhakti without Karma (Hands) leads to sentimental passivity."]}],["$","div",null,{"className":"bg-orange-600/5 border border-orange-500/20 p-8 rounded-3xl","children":[["$","h4",null,{"className":"text-orange-400 font-bold mb-4 flex items-center gap-2","children":[["$","span",null,{"className":"w-2 h-2 rounded-full bg-orange-500"}],"A Recommended \"Beginner Stack\""]}],["$","ul",null,{"className":"space-y-4 text-muted-foreground m-0 list-none p-0","children":[["$","li",null,{"className":"flex gap-4","children":[["$","strong",null,{"children":"07:00 AM:"}]," 15 mins of Raja Yoga (Meditation) to stabilize the day."]}],["$","li",null,{"className":"flex gap-4","children":[["$","strong",null,{"children":"09:00 AM - 05:00 PM:"}]," Karma Yoga (Mindful work) as your primary practice."]}],["$","li",null,{"className":"flex gap-4","children":[["$","strong",null,{"children":"08:00 PM:"}]," 10 mins of Bhakti Yoga (Mantra/Prayer) to vent emotional stress."]}]]}]]}]]}]}]
23:["$","section",null,{"className":"mb-20 shadow-2xl overflow-hidden relative rounded-3xl border border-orange-900/40 bg-gradient-to-br from-orange-950/20 to-background p-12 text-center","children":["$","div",null,{"className":"relative z-10","children":[["$","h2",null,{"className":"text-4xl font-display font-bold mb-4","children":"Unsure about your dominant driver?"}],["$","p",null,{"className":"text-xl text-muted-foreground max-w-2xl mx-auto mb-10 leading-relaxed","children":["The ",["$","strong",null,{"children":"Faith Finder"}]," maps your personality to these four paths, giving you a custom starting plan designed for your specific \"Vasanas\" (latent tendencies)."]}],["$","$L29",null,{"href":"/faith-finder","eventLabel":"chooser_cta:choose-between-bhakti-jnana-karma-raja-yoga:faith-finder","trackPathName":"faith-finder","className":"inline-flex items-center rounded-full bg-orange-600 hover:bg-orange-700 px-10 py-5 text-white font-bold text-xl transition-all","children":["Take the Assessment ",["$","svg",null,{"ref":"$undefined","xmlns":"http://www.w3.org/2000/svg","width":24,"height":24,"viewBox":"0 0 24 24","fill":"none","stroke":"currentColor","strokeWidth":2,"strokeLinecap":"round","strokeLinejoin":"round","className":"lucide lucide-arrow-right ml-2 w-6 h-6","children":[["$","path","1ays0h",{"d":"M5 12h14"}],["$","path","xquz4c",{"d":"m12 5 7 7-7 7"}],"$undefined"]}]]}]]}]}]
24:["$","section",null,{"className":"mb-20","children":[["$","h2",null,{"className":"font-display text-4xl font-bold mb-10 text-center","children":"Frequently Asked Questions"}],["$","div",null,{"className":"grid md:grid-cols-2 gap-6","children":[["$","div","Can I practice more than one path at once?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Can I practice more than one path at once?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Yes. This is known as 'Yoga Synthesis' or Integral Yoga. Most practitioners use Karma Yoga during the day, Bhakti for emotional grounding, and Raja or Jnana for dedicated morning practice."}]]}],["$","div","Which path is the fastest for a beginner?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"Which path is the fastest for a beginner?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"The 'fastest' path is the one you don't quit. For a restless person, Karma Yoga is fastest because they can start now. For a thinker, Jnana is fastest because it provides the map they need to begin."}]]}],["$","div","How do I deal with the 'dryness' of analytical paths?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"How do I deal with the 'dryness' of analytical paths?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Analytical paths like Jnana can feel dry if not balanced with Bhakti (devotion) or Karma (service). Spiritual growth requires both the 'light' of wisdom and the 'heat' of love."}]]}],["$","div","What if I don't believe in a personal God?",{"className":"rounded-2xl border border-border/40 bg-card/40 p-8 shadow-sm","children":[["$","h3",null,{"className":"text-xl font-bold mb-4","children":"What if I don't believe in a personal God?"}],["$","p",null,{"className":"text-muted-foreground leading-relaxed italic border-l-2 border-orange-500/30 pl-4","children":"Raja and Jnana Yoga do not require belief in a personal deity. They are systems of psychological training and philosophical inquiry that can be practiced by anyone, regardless of religious background."}]]}]]}]]}]
