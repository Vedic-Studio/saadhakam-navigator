{
  "content_rules": {
    "source": {
      "path": "/Users/ankitmishra/Developer/Sadhaka/seo/content-rules.md",
      "title": "Content Quality & Generation Rules"
    },
    "page_type_rules": [
      {
        "slug": "topic_hub",
        "route_pattern": "/topics/{topic}",
        "min_word_count": 800,
        "required_sections": [
          "Topic overview (clear, encyclopedic definition + cultural context)",
          "Recommended practices (with internal links)",
          "Recommended traditions/lineages",
          "Curated reading/guides list",
          "Call-to-action (Faith Finder or related pathway)"
        ]
      },
      {
        "slug": "combinatorial",
        "route_pattern": "/practices/{practice}/for/{goal}",
        "min_word_count": 1200,
        "required_sections": [
          "Practice definition and historical origins",
          "**Core alignment**: Detailed, specific explanation of *why* this practice aligns with the specific goal (THIS section must be highly unique per page)",
          "Step-by-step instructions",
          "Contraindications / Safety notes (must adhere strictly to `exclusions.md`)",
          "Related practices for this goal"
        ]
      },
      {
        "slug": "sacred_text_chapter",
        "route_pattern": "/texts/{text}/chapter-{chapter}",
        "min_word_count": 2500,
        "required_sections": [
          "Original Sanskrit text (Devanagari) + IAST transliteration",
          "Word-by-word literal translation (Anvaya)",
          "Complete English translation (public domain / fair use only)",
          "Multi-tradition commentary synthesis",
          "Modern practical application",
          "5-10 FAQ Schema questions"
        ]
      },
      {
        "slug": "sacred_text_shloka",
        "route_pattern": "/texts/{text}/chapter-{chapter}/shloka-{shloka}",
        "min_word_count": 1500,
        "required_sections": [
          "Original Sanskrit text (Devanagari) + IAST transliteration",
          "Word-by-word literal translation (Anvaya)",
          "Complete English translation (public domain / fair use only)",
          "Multi-tradition commentary synthesis",
          "Modern practical application",
          "5-10 FAQ Schema questions"
        ]
      },
      {
        "slug": "sanskrit_lexicon",
        "route_pattern": "/learn/sanskrit/{word}",
        "min_word_count": 1000,
        "required_sections": [
          "Devanagari + IAST + phonetic pronunciation",
          "Etymology (Sanskrit root/dhatu + suffix)",
          "Denotative and connotative meanings",
          "Usage examples in major texts",
          "Western philosophical equivalents (if applicable)"
        ]
      }
    ],
    "uniqueness_rules": [
      {
        "description": "No find-and-replace pSEO pages. At least 40% text on combinatorial pages must be unique to the practice-goal combination.",
        "min_unique_percent": 40
      },
      {
        "description": "Every target concept must map to one canonical URL via linkMap.json.",
        "min_unique_percent": null
      }
    ],
    "formatting_rules": [
      {
        "category": "visual_hierarchy",
        "rules": [
          "Exactly one H1 per page",
          "Use H2 and H3 in logical order without skipping levels"
        ]
      },
      {
        "category": "schema",
        "rules": [
          "Include Article schema on informational and guide pages",
          "Include FAQPage schema for Q&A sections",
          "Include visible breadcrumbs and BreadcrumbList schema"
        ]
      },
      {
        "category": "internal_linking",
        "rules": [
          "Minimum 3 internal links per page",
          "Use descriptive anchor text"
        ]
      }
    ],
    "citation_rules": []
  },
  "exclusions": {
    "source": {
      "path": "/Users/ankitmishra/Developer/Sadhaka/seo/exclusions.md",
      "title": "Sādhaka SEO & pSEO Exclusions Policy"
    },
    "fail_closed": true,
    "categories": [
      {
        "name": "medical_and_health_claims",
        "disallowed": [
          "\"Cures [disease/condition]\"",
          "\"Treats [disease/condition]\"",
          "\"Heals [disease/condition]\"",
          "\"Replaces therapy/medication\"",
          "\"Proven to stop...\""
        ],
        "allowed": [
          "\"May support emotional well-being\"",
          "\"Traditionally used to cultivate calmness\"",
          "\"Many practitioners report increased focus\"",
          "\"Complements a holistic lifestyle\""
        ]
      },
      {
        "name": "tantra_and_esoteric_practices",
        "disallowed": [
          "\"Sexual tantra\" or neo-tantric sexual practices",
          "Left-hand path (Vamachara) rituals involving breaking societal taboos (unless strictly in an academic/historical context, unassociated with \"how-to\" practices)",
          "Occult practices framed as \"magic\" or \"supernatural powers\" (Siddhis) as goals to be chased"
        ],
        "allowed": [
          "Classical Tantra (Trika, Shaiva-Shakta philosophy)",
          "Mantra, Yantra, and deity yoga",
          "The theology of recognition (Pratyabhijna)"
        ]
      },
      {
        "name": "copyright_and_ip",
        "disallowed": [
          "Reproducing the entirety of copyrighted contemporary translations or purports (e.g., A.C. Bhaktivedanta Swami Prabhupada's \"Bhagavad-gita As It Is\" purports, or recent translations by living authors) verbatim without written permission.",
          "Scraping and republishing paywalled content from competitors (Yoga International, Tantra Illuminated)."
        ],
        "allowed": [
          "**Fair Use**: Quoting short sentences or single paragraphs from copyrighted commentaries for the purpose of analysis, review, or comparison, accompanied by proper citation.",
          "**Public Domain**: Using historical translations (e.g., early 1900s translations) or creating original translations of original Sanskrit text.",
          "Creating **unique summaries and syntheses** of traditional commentaries (Shankara, Ramanuja, Madhva) based on public domain or widely understood interpretations."
        ]
      },
      {
        "name": "defamation_and_sectarianism",
        "disallowed": [
          "Using \"cult\", \"scam\", or defamatory language toward any established lineage, organization, or guru.",
          "Taking sectarian sides in philosophical debates (e.g., stating \"Advaita is the only true philosophy and Dvaita is wrong\").",
          "Generating aggressive comparative pages targeting living gurus (e.g., \"Sadhguru vs Sri Sri Ravi Shankar\")."
        ],
        "allowed": [
          "Academic, respectful comparisons mapping the historical arguments (e.g., \"How Shankara and Ramanuja differ on the nature of Brahman\").",
          "Highlighting the unique strengths and historical context of each path."
        ]
      }
    ],
    "sensitive_goals_requiring_disclaimer": [
      "anxiety",
      "depression",
      "trauma",
      "insomnia",
      "stress"
    ],
    "disclaimer_text": "Sādhaka provides traditional spiritual perspectives and practices. This content is for educational purposes and is not a substitute for professional medical or mental health advice.",
    "implementation_rules": [
      {
        "step": "Load these exclusions."
      },
      {
        "step": "Scan generated output against an array of disallowed regex patterns (e.g., `/cures?\\s+(anxiety|depression|cancer|disease)/i`)."
      },
      {
        "step": "If a match is found, the script must **abort** generation for that specific permutation, log an error, and require manual human review."
      }
    ]
  },
