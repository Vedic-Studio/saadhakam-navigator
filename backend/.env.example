# FastAPI Backend — Environment Configuration

# ─── LLM Provider ──────────────────────────────────────────────────────────────
# Select the provider used by the writer/platform agents.
SADHAKA_LLM_PROVIDER=openai

# OpenAI is the default provider.
SADHAKA_OPENAI_API_KEY=sk-proj-...

# Optionally override the model (default: gpt-4o-mini)
# SADHAKA_OPENAI_MODEL=gpt-4o-mini

# Anthropic remains supported as an optional provider.
# Required only when SADHAKA_LLM_PROVIDER=anthropic
SADHAKA_ANTHROPIC_API_KEY=sk-ant-...

# Optionally override the model (default: claude-3-5-sonnet-20241022)
# SADHAKA_ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ─── App ───────────────────────────────────────────────────────────────────────
SADHAKA_ENVIRONMENT=development

# Frontend production note:
# The Next.js frontend must separately define CONTENT_AGENT_API_BASE to point at
# this backend's public /api base URL.
# Current production value used by the frontend deployment:
# CONTENT_AGENT_API_BASE=https://content-agent.opensadhaka.com/api

# ─── Knowledge Store ───────────────────────────────────────────────────────────
# Rebuild parsed JSON from source markdown on every startup (dev: true, prod: false)
SADHAKA_KNOWLEDGE_REFRESH_ON_STARTUP=true

# ─── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the frontend
SADHAKA_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Database ──────────────────────────────────────────────────────────────────
# SQLite by default (zero config). Switch to PostgreSQL for production:
# SADHAKA_DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/sadhaka
# (leave empty to use default: sqlite:///backend/data/content_agents.db)

# ─── Legacy Node server (faith-finder-server.js) ──────────────────────────────
PORT=3001
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@sadhaka.com
